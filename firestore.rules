rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own document
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Users can create and update their own document
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      // No deletes allowed (or restrict as needed)
      allow delete: if false;
    }
    
    // Buildings collection
    match /buildings/{buildingId} {
      // Anyone can read buildings (for public pages)
      allow read: if true;
      
      // Only authenticated building owners can create their own buildings
      allow create: if isAuthenticated() && 
                       request.resource.data.ownerId == request.auth.uid;
      
      // Building owners can update their own buildings
      // OR anyone can increment the scanViews field only
      allow update: if isOwner(resource.data.ownerId) || 
                       (// Allow scanViews increment from anyone
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['scanViews']) &&
                        request.resource.data.scanViews == resource.data.scanViews + 1
                       );
      
      // Only building owners can delete their buildings
      allow delete: if isOwner(resource.data.ownerId);
    }
    
    // Units collection
    match /units/{unitId} {
      // Anyone can read units (for public pages)
      allow read: if true;
      
      // Only authenticated building owners can create units
      // We verify ownership by checking the building's ownerId
      allow create: if isAuthenticated() && 
                       exists(/databases/$(database)/documents/buildings/$(request.resource.data.buildingId)) &&
                       get(/databases/$(database)/documents/buildings/$(request.resource.data.buildingId)).data.ownerId == request.auth.uid;
      
      // Only building owners can update units
      allow update: if isAuthenticated() && 
                       exists(/databases/$(database)/documents/buildings/$(resource.data.buildingId)) &&
                       get(/databases/$(database)/documents/buildings/$(resource.data.buildingId)).data.ownerId == request.auth.uid;
      
      // Only building owners can delete units
      allow delete: if isAuthenticated() && 
                       exists(/databases/$(database)/documents/buildings/$(resource.data.buildingId)) &&
                       get(/databases/$(database)/documents/buildings/$(resource.data.buildingId)).data.ownerId == request.auth.uid;
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
