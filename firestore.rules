rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own document
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Users can create and update their own document
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      // No deletes allowed (or restrict as needed)
      allow delete: if false;
    }
    
    // Listing Groups collection
    match /listing-groups/{buildingId} {
      // Anyone can read listing-groups (for public pages)
      allow read: if true;
      
      // Only authenticated listing-group owners can create their own listing-groups
      allow create: if isAuthenticated() && 
                       request.resource.data.ownerId == request.auth.uid;
      
      // Listing-group owners can update their own listing-groups
      // OR anyone can increment the scanViews field only
      allow update: if isOwner(resource.data.ownerId) || 
                       (// Allow scanViews increment from anyone
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['scanViews']) &&
                        request.resource.data.scanViews == resource.data.scanViews + 1
                       );
      
      // Only listing-group owners can delete their listing-groups
      allow delete: if isOwner(resource.data.ownerId);
    }
    
    // Building Members collection
    match /building_members/{memberId} {
      // Users can read their own memberships
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      // Users can create memberships for themselves
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      
      // No updates or deletes allowed (prevent manipulation)
      allow update, delete: if false;
    }
    
    // Listings collection
    // Listings collection
    match /listings/{unitId} {
      // Anyone can read listings (for public pages)
      allow read: if true;
      
      // Crowdsourcing Model:
      // 1. Any authenticated user can create a listing, provided they set themselves as owner
      allow create: if isAuthenticated() && 
                       request.resource.data.ownerId == request.auth.uid;
      
      // 2. Only the UNIT owner can update their listing
      allow update: if isAuthenticated() && 
                       resource.data.ownerId == request.auth.uid;
      
      // 3. Only the UNIT owner can delete their listing
      allow delete: if isAuthenticated() && 
                       resource.data.ownerId == request.auth.uid;
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
