rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own document
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Users can create and update their own document
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      // No deletes allowed (or restrict as needed)
      allow delete: if false;
    }
    
    // Listing Groups collection
    match /listing-groups/{buildingId} {
      // Anyone can read listing-groups (for public pages)
      allow read: if true;
      
      // Only authenticated listing-group owners can create their own listing-groups
      allow create: if isAuthenticated() && 
                       request.resource.data.ownerId == request.auth.uid;
      
      // Listing-group owners can update their own listing-groups
      // OR anyone can increment the scanViews field only
      allow update: if isOwner(resource.data.ownerId) || 
                       (// Allow scanViews increment from anyone
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['scanViews']) &&
                        request.resource.data.scanViews == resource.data.scanViews + 1
                       );
      
      // Only listing-group owners can delete their listing-groups
      allow delete: if isOwner(resource.data.ownerId);
    }
    
    // Listings collection
    match /listings/{unitId} {
      // Anyone can read listings (for public pages)
      allow read: if true;
      
      // Only authenticated listing-group owners can create listings
      // We verify ownership by checking the listing-group's ownerId
      allow create: if isAuthenticated() && 
                       exists(/databases/$(database)/documents/listing-groups/$(request.resource.data.buildingId)) &&
                       get(/databases/$(database)/documents/listing-groups/$(request.resource.data.buildingId)).data.ownerId == request.auth.uid;
      
      // Only listing-group owners can update listings
      allow update: if isAuthenticated() && 
                       exists(/databases/$(database)/documents/listing-groups/$(resource.data.buildingId)) &&
                       get(/databases/$(database)/documents/listing-groups/$(resource.data.buildingId)).data.ownerId == request.auth.uid;
      
      // Only listing-group owners can delete listings
      allow delete: if isAuthenticated() && 
                       exists(/databases/$(database)/documents/listing-groups/$(resource.data.buildingId)) &&
                       get(/databases/$(database)/documents/listing-groups/$(resource.data.buildingId)).data.ownerId == request.auth.uid;
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
